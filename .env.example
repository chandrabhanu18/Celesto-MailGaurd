# Celesto Provider Settings
CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
CELESTO_BACKEND=firecracker
CELESTO_TEMPLATE_ID=coding-agent
SANDBOX_PROVIDER_MODE=auto

# Server & Networking
API_PORT=8080
PORT=8080
HOST=0.0.0.0
DEBUG=true

# Database (PostgreSQL for Docker Compose; sqlite+aiosqlite:///./mailguard.db for local dev)
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger

# LLM Advisory Evaluator Configuration
LLM_PROVIDER=mock
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30

# Security Invariant Limits
MAX_SANDBOX_OUTPUT_BYTES=524288
EXECUTION_TIMEOUT_SECONDS=45
MAX_LLM_OUTPUT_BYTES=262144
