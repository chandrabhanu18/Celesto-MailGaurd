# Celesto Configuration
# Required for REAL_CELESTO mode (get from https://celesto.ai -> Settings -> Security)
CELESTO_API_KEY=

# Provider mode: "auto", "real", or "demo"
# "auto" uses real Celesto if CELESTO_API_KEY is set, otherwise falls back to demo
# "real" forces RealCelestoProvider (fails if key is missing)
# "demo" forces DemoFallbackProvider (safe local mock subprocess for zero-credential development)
SANDBOX_PROVIDER_MODE=auto

# Celesto Cloud or Local VM settings
CELESTO_PROVIDER=cloud
CELESTO_TEMPLATE_ID=coding-agent

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./mailguard.db
